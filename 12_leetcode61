
class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if (head == nullptr || head->next == nullptr || k == 0) {
            return head;
        }

        ListNode* curr = head;
        int n = 1;

        while (curr->next != nullptr) {
            curr = curr->next;
            n++;
        }

        k = k % n;

        if (k == 0) {
            return head;
        }

        curr->next = head;

        int steps = n - k;
        ListNode* newTail = curr;

        while (steps--) {
            newTail = newTail->next;
        }

        ListNode* newHead = newTail->next;
        newTail->next = nullptr;

        return newHead;
    }
};
